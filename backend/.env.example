# Database Configuration
MONGODB_URI=mongodb://localhost:27017/spotGuide
DB_NAME=spotGuide

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URLs
FRONTEND_URL_DEV=http://localhost:8100
FRONTEND_URL_PROD=https://your-production-frontend-url.com
FRONTEND_URL=http://localhost:8100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
